# Local PostgreSQL connection used only by Next.js server routes.
# Keep this value private; never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://business_ops_app:URL_ENCODED_PASSWORD@localhost:5432/Business%20OPS
PGSSL=false

# AI Copilot Configuration
AI_COPILOT_ENABLED=true

# AI Provider Settings - Using FREE Ollama (local)
AI_API_KEY=ollama
AI_MODEL=qwen3.5:2b
AI_BASE_URL=http://localhost:11434/v1

# AI Cost Tracking (set to 0 for FREE local models)
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
AI_DAILY_BUDGET_USD=2
AI_MAX_REQUESTS_PER_HOUR=20
AI_MAX_REQUEST_COST_USD=0.25

# Free, local multilingual Whisper service (run backend/whisper first)
# WHISPER_BASE_URL=http://127.0.0.1:8001/v1

# Free, local Piper TTS service (run backend/piper first)
# PIPER_BASE_URL=http://127.0.0.1:8002
