NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Copilot Configuration
AI_COPILOT_ENABLED=true

# Option 1: Qwen Local via Ollama (100% Free, Private, Multi-lingual: English, Hindi, Telugu, Tamil, etc.)
# 1. Install Ollama: https://ollama.com
# 2. Run: ollama run qwen2.5:1.5b   (or: ollama run qwen2.5:3b / qwen2.5:7b)
# AI_MODEL=qwen2.5:1.5b
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama

# Option 2: Qwen Cloud via OpenRouter (Multi-lingual)
# AI_MODEL=qwen/qwen-2.5-7b-instruct
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-your-key

# Option 3: Google Gemini
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=

AI_INPUT_COST_PER_MILLION_USD=0.15
AI_OUTPUT_COST_PER_MILLION_USD=0.60
AI_DAILY_BUDGET_USD=2
AI_MAX_REQUESTS_PER_HOUR=50
AI_MAX_REQUEST_COST_USD=0.25
